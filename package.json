{
  "name": "proyecto-daci-lineamientos",
  "version": "0.1.0",
  "private": true,
  "description": "Pipeline en Node.js (JS puro) para convertir requerimientos y lineamientos crudos a Markdown y generar matrices Excel.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generar:requerimientos": "node src/index.js step:0 --solo=requerimientos",
    "generar:lineamientos": "node src/index.js step:0 --solo=lineamientos",
    "step:0": "node src/index.js step:0",
    "step:1": "node src/index.js step:1",
    "step:2": "node --env-file=.env src/index.js step:2",
    "step:3": "node src/index.js step:3",
    "step:4": "node src/index.js step:4",
    "step:5": "node src/index.js step:5",
    "generate:formato_json_ficha_requerimientos": "node --env-file=.env src/index.js generate:formato_json_ficha_requerimientos",
    "analizar:requerimiento": "node --env-file=.env src/index.js step:2",
    "pipeline": "node --env-file=.env src/index.js pipeline",
    "api": "node src/platform/server.js",
    "worker": "node src/platform/worker.js",
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "build": "tsc --project web/tsconfig.json && vite build --config web/vite.config.ts",
    "db:migrate": "node scripts/migrate.js",
    "data:import": "node scripts/import-legacy.js",
    "config:check": "node scripts/check-config.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/test-integration.js",
    "test:openai": "node scripts/test-integration.js --openai"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "chalk": "^5.3.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fast-glob": "^3.3.2",
    "fastify": "^5.12.5",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.8.0",
    "mysql2": "^3.24.5",
    "openai": "^6.39.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@11.15.1"
}
